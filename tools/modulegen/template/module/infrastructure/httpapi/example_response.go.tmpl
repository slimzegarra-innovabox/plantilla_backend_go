package httpapi

import (
	"time"

	"github.com/google/uuid"

	"myapp.v1.0.0/internal/example/application/dto"
)

// ExampleResponse es la representación pública. Contrato JSON en snake_case.
type ExampleResponse struct {
	UUID      uuid.UUID `json:"uuid"`
	Name      string    `json:"name"`
	Version   int       `json:"version"`
	CreatedBy uuid.UUID `json:"created_by"`
	CreatedAt time.Time `json:"created_at"`
	UpdatedAt time.Time `json:"updated_at"`
}

func toExampleResponse(d dto.ExampleData) ExampleResponse {
	return ExampleResponse{
		UUID: d.UUID, Name: d.Name, Version: d.Version, CreatedBy: d.CreatedBy,
		CreatedAt: d.CreatedAt.UTC(), UpdatedAt: d.UpdatedAt.UTC(),
	}
}
