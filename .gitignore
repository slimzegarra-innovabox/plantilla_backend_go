# Binaries for programs and plugins
*.exe
*.dll
*.so
*.dylib

# Compiled object files, static and dynamic libs
*.o
*.a
*.out
*.h
*.log

# Folders and files generated by Golang
/bin/
/pkg/
/vendor/


# Dependency directories (remove the comment if you have dependencies you want to avoid committing)
/vendor/

# Go workspace file
go.work
go.work.sum

# Docker specific files
docker-compose.override.yml
docker-compose.override.yaml
postgres_data
# Log files
*.log


# Config files
/config/config.yaml
/config/config.toml
/config/config.json

# Ignore GoLand IDE project files
.idea/

# Ignore VS Code settings
.vscode/

# Ignore Git-specific files
*.orig

# Output of the coverage tool
*.coverprofile

# Profiling data
*.pprof

# Output of the race detector
*.race

# Output of the memory sanitizer
*.msan

# Docker volumes
docker_data/
docker_volumes/


.backups

instruction/migrate

# Artefactos de desarrollo (Air, binarios locales)
/tmp/
/main
build-errors.log

# Variables de entorno reales: nunca se versionan (.env.template sí)
.env
.env.*
!.env.template

# SBOM generados por make scan
sbom/

# Cobertura (make cover)
coverage.out
coverage.html
coverage-e2e/
coverage-e2e.out

# Binario de make module (el código está en tools/modulegen)
/modulegen
