# ==============================================================
# PLANTILLA DE VARIABLES DE ENTORNO (solo desarrollo local)
#
#   cp .env.template .env      y completar los valores marcados con change-me
#
# - .env NUNCA se versiona. En QA/producción las variables vienen del
#   entorno (ECS task definition, Secrets Manager…), nunca de un archivo.
# - Este archivo solo lleva MARCADORES: ningún valor real.
# - La lista completa y los valores por defecto están en
#   internal/shared/infrastructure/config/config.go
# ==============================================================

# develop | test | qa | production
APP_ENV=develop
LOG_LEVEL=debug

# ----------------------------------------------------------
# HTTP
# ----------------------------------------------------------
HTTP_ADDR=:8080
# Orígenes del frontend, separados por coma. Nunca '*'.
HTTP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# IPs/CIDR de los proxies cuyo X-Forwarded-For se acepta (p. ej. las subredes del ALB).
# Obligatoria fuera de develop/test: 'none' si no hay proxy delante. Nunca 0.0.0.0/0.
# Vacía detrás de un balanceador, todos los clientes comparten su IP (rate limit, logs).
HTTP_TRUSTED_PROXIES=
# HTTP_RATE_LIMIT_RPS=20        # 0 lo desactiva
# HTTP_RATE_LIMIT_BURST=40
# HTTP_BODY_LIMIT_BYTES=1048576
# HTTP_REQUEST_TIMEOUT=25s
# Al apagar, /health/ready responde 503 durante este tiempo antes de cerrar el puerto,
# para que el balanceador retire la instancia sin cortar peticiones. 0 en develop/test;
# 5s por defecto en el resto. stop_grace_period debe superar DRAIN_DELAY + SHUTDOWN_TIMEOUT.
# HTTP_DRAIN_DELAY=5s

# ----------------------------------------------------------
# BASE DE DATOS (la usan cmd/api y cmd/migrate)
# app_postgres dentro de Docker (make up); localhost si corres `make run`.
# ----------------------------------------------------------
DB_HOST=app_postgres
DB_PORT=5432
DB_USER=myapp_user
DB_PASSWORD=change-me
DB_NAME=myapp_db
# disable solo en local; en QA/producción: require o verify-full
DB_SSLMODE=disable
# Plazos que aplica PostgreSQL a cada sesión (0 = sin límite). cmd/migrate no usa
# statement_timeout (una migración puede tardar), pero sí lock_timeout.
# Con PgBouncer en modo transaction (rechaza parámetros de arranque) ponerlos en 0 y
# definirlos en el rol: ALTER ROLE myapp_user SET statement_timeout = '30s';
# DB_STATEMENT_TIMEOUT=30s
# DB_LOCK_TIMEOUT=10s
# DB_IDLE_IN_TRANSACTION_TIMEOUT=60s

# Las usa el contenedor de Postgres de develop.yml / test.yml
POSTGRES_USER=myapp_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=myapp_db

# ----------------------------------------------------------
# JWT (solo verificación; los tokens los emite el servicio de identidad)
# ----------------------------------------------------------
# Al menos 32 bytes. Generar con: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_ISSUER=https://auth.example.com
JWT_AUDIENCE=myapp-api

# ==============================================================
# INTEGRACIONES OPCIONALES
# Cada una se activa con <X>_ENABLED=true; solo entonces sus
# variables son obligatorias y se validan al arrancar.
# ==============================================================

# ----------------------------------------------------------
# OPENTELEMETRY (trazas y métricas; en AWS → ADOT Collector → X-Ray / CloudWatch)
# ----------------------------------------------------------
OTEL_ENABLED=false
# OTEL_SERVICE_NAME=myapp-api            # por defecto myapp-api / myapp-worker
# Variables estándar del SDK (no se duplican en la configuración de la app):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # el colector (sidecar en ECS)
# OTEL_TRACES_SAMPLER=parentbased_traceidratio         # producción con mucho tráfico
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_METRICS_EXPORTER=none                           # solo trazas (p. ej. Jaeger en local)
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=myapp

# ----------------------------------------------------------
# REDIS / ASYNQ (tareas en segundo plano; cmd/api encola, cmd/worker procesa)
# Sin Redis tampoco hay outbox: los eventos de los módulos se descartan (ADR 0006).
# ----------------------------------------------------------
REDIS_ENABLED=false
REDIS_ADDR=app_redis:6379
# Obligatoria fuera de develop/test, junto con REDIS_TLS=true (por defecto fuera de develop).
REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TLS=false

# ----------------------------------------------------------
# AWS (común a S3 y SQS)
# ----------------------------------------------------------
AWS_REGION=us-east-1
# Solo en develop (perfil de ~/.aws montado en el contenedor).
# En QA/producción se usa el IAM Role y AWS_PROFILE se rechaza.
AWS_PROFILE=

# ----------------------------------------------------------
# S3 (almacenamiento de objetos)
# ----------------------------------------------------------
S3_ENABLED=false
S3_BUCKET=
# S3_UPLOAD_MAX_BYTES=10485760
# S3_PRESIGN_TTL=5m             # máximo 1h

# ----------------------------------------------------------
# CORREO - Brevo
# ----------------------------------------------------------
BREVO_ENABLED=false
BREVO_API_KEY=change-me
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=MyApp
# BREVO_TIMEOUT=10s

# ----------------------------------------------------------
# WORKER (solo cmd/worker)
# ----------------------------------------------------------
# WORKER_CONCURRENCY=10
# WORKER_SHUTDOWN_TIMEOUT=30s
# Sonda de liveness del worker (solo loopback; la usa `worker healthcheck`).
# WORKER_HEALTH_ADDR=127.0.0.1:8081
SQS_ENABLED=false
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/mi-cola
# SQS_WAIT_TIME=20s
# SQS_VISIBILITY_TIMEOUT=60s
# SQS_MAX_MESSAGES=10
